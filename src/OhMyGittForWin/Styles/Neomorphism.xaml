<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neo Palette based on Figma Neomorphism Guide -->
    <Color x:Key="NeoBgColor">#181A20</Color>
    <Color x:Key="NeoSurfaceColor">#21252E</Color>
    <Color x:Key="NeoSurfaceLightColor">#282D38</Color>
    <Color x:Key="NeoSunkenColor">#14161B</Color>

    <Color x:Key="NeoAccentOrangeColor">#FF7700</Color>
    <Color x:Key="NeoAccentOrangeLight">#FFA043</Color>
    <Color x:Key="NeoAccentBlueColor">#3B82F6</Color>
    <Color x:Key="NeoAccentCyanColor">#06B6D4</Color>
    <Color x:Key="NeoAccentGreenColor">#10B981</Color>
    <Color x:Key="NeoAccentRedColor">#EF4444</Color>

    <SolidColorBrush x:Key="NeoBgBrush" Color="{StaticResource NeoBgColor}"/>
    <SolidColorBrush x:Key="NeoSurfaceBrush" Color="{StaticResource NeoSurfaceColor}"/>
    <SolidColorBrush x:Key="NeoSunkenBrush" Color="{StaticResource NeoSunkenColor}"/>
    <SolidColorBrush x:Key="NeoTextPrimary" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="NeoTextSecondary" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="NeoTextMuted" Color="#6B7280"/>
    <SolidColorBrush x:Key="NeoAccentOrangeBrush" Color="{StaticResource NeoAccentOrangeColor}"/>

    <!-- 3D Bevel Gradients -->
    <LinearGradientBrush x:Key="NeoRaisedBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#404656" Offset="0.0"/>
        <GradientStop Color="#2B303C" Offset="0.5"/>
        <GradientStop Color="#121418" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeoSunkenBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D0E12" Offset="0.0"/>
        <GradientStop Color="#1C2028" Offset="0.7"/>
        <GradientStop Color="#353B49" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeoSurfaceGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#262A34" Offset="0.0"/>
        <GradientStop Color="#1D2028" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeoOrangeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource NeoAccentOrangeLight}" Offset="0.0"/>
        <GradientStop Color="{StaticResource NeoAccentOrangeColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Soft Drop Shadows (GPU-Optimized radii for 60+ FPS rendering) -->
    <DropShadowEffect x:Key="NeoCardShadow" BlurRadius="12" Direction="315" ShadowDepth="4" Opacity="0.4" Color="#0B0C0F"/>
    <DropShadowEffect x:Key="NeoButtonShadow" BlurRadius="6" Direction="315" ShadowDepth="2" Opacity="0.4" Color="#0B0C0F"/>
    <DropShadowEffect x:Key="NeoGlowOrange" BlurRadius="8" Direction="0" ShadowDepth="0" Opacity="0.75" Color="#FF7700"/>
    <DropShadowEffect x:Key="NeoGlowBlue" BlurRadius="8" Direction="0" ShadowDepth="0" Opacity="0.65" Color="#3B82F6"/>

    <!-- Neo Card Style (Direct GPU Rasterization without Off-screen Target Invalidation) -->
    <Style x:Key="NeoCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeoSurfaceGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeoRaisedBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Neo Card with Shadow (for static modal dialogs) -->
    <Style x:Key="NeoCardWithShadow" TargetType="Border" BasedOn="{StaticResource NeoCard}">
        <Setter Property="Effect" Value="{StaticResource NeoCardShadow}"/>
    </Style>

    <!-- Neo Sunken Panel Style -->
    <Style x:Key="NeoSunkenCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeoSunkenBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeoSunkenBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- Neo Button Style with Tactile 3D Micro-interactions -->
    <Style x:Key="NeoButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NeoTextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{StaticResource NeoSurfaceGradient}"
                            BorderBrush="{StaticResource NeoRaisedBorderBrush}" BorderThickness="1.2"
                            CornerRadius="12" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5"
                            Effect="{StaticResource NeoButtonShadow}">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="btnTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="hoverGlow" Background="#2C313E" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Fluid Hover Micro-interaction -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="btnTranslate" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="hoverGlow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="btnTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="hoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Tactile Pressed Sunk-in Micro-interaction -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="0.965" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="0.965" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="btnTranslate" Storyboard.TargetProperty="Y" To="1.2" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="btnTranslate" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource NeoSunkenBrush}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource NeoSunkenBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Neo Primary Accent Glow Button (Orange Neon with Tactile Physics) -->
    <Style x:Key="NeoPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="glowBorder" Background="{StaticResource NeoOrangeGradient}"
                            BorderBrush="#FFB066" BorderThickness="1"
                            CornerRadius="14" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5"
                            Effect="{StaticResource NeoGlowOrange}">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="glowScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="glowTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glowScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="glowScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="glowTranslate" Storyboard.TargetProperty="Y" To="-1.2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="glowBorder" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glowScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="glowScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="glowTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="glowBorder" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glowScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="glowScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="glowTranslate" Storyboard.TargetProperty="Y" To="1.2" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="glowBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glowScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="glowScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="glowTranslate" Storyboard.TargetProperty="Y" To="-1.2" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="glowBorder" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Neo Secondary Accent Button (Electric Cyan/Blue with Tactile Physics) -->
    <Style x:Key="NeoAccentBlueButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="blueBorder" Background="#2563EB"
                            BorderBrush="#60A5FA" BorderThickness="1"
                            CornerRadius="12" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5"
                            Effect="{StaticResource NeoGlowBlue}">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="blueScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="blueTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="blueScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="blueScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="blueTranslate" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="blueScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="blueScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="blueTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="blueScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="blueScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.06"/>
                                        <DoubleAnimation Storyboard.TargetName="blueTranslate" Storyboard.TargetProperty="Y" To="1.2" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="blueScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="blueScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="blueTranslate" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Neo Inset / Sunken TextBox with Focus Illumination -->
    <Style x:Key="NeoTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NeoSunkenBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NeoTextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource NeoAccentOrangeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeoSunkenBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource NeoAccentOrangeBrush}"/>
                            <Setter TargetName="border" Property="Effect" Value="{StaticResource NeoGlowOrange}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Neo ListBoxItem Style with Fluid Hover & Selection Indicator Expansion -->
    <Style x:Key="NeoListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NeoTextPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6" 
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Hover Layer -->
                            <Border x:Name="HoverLayer" 
                                    Background="#222736" 
                                    BorderBrush="#31394B" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Opacity="0"
                                    Margin="-6,-4"/>
                            <!-- Selected Layer -->
                            <Border x:Name="SelectedLayer" 
                                    Background="#273145" 
                                    BorderBrush="#3B82F6" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Opacity="0"
                                    Margin="-6,-4"/>
                            <!-- Left Active Indicator Pill -->
                            <Border x:Name="ActiveIndicator"
                                    Width="3.5"
                                    Height="16"
                                    CornerRadius="1.75"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-4,0,0,0"
                                    Background="#38BDF8"
                                    Visibility="Collapsed"/>
                            <!-- Content -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Instant Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.85"/>
                        </MultiTrigger>
                        <!-- Instant Selection -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedLayer" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented Tab Button with Instant 0ms Physics Interaction -->
    <Style x:Key="NeoSegmentedTabButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="tabBorder" CornerRadius="10" Padding="16,8" Background="Transparent">
                        <Grid>
                            <Border x:Name="hoverBg" Background="#262A34" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter x:Name="cp" TextElement.FontWeight="Bold" TextElement.FontSize="12"
                                              TextElement.Foreground="{StaticResource NeoTextSecondary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="hoverBg" Property="Opacity" Value="0.75"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource NeoSurfaceGradient}"/>
                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource NeoRaisedBorderBrush}"/>
                            <Setter TargetName="tabBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="tabBorder" Property="Effect" Value="{StaticResource NeoButtonShadow}"/>
                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
