<UserControl x:Class="OhMyGittForWin.Views.IdeaDiffViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:OhMyGittForWin.Converters"
             xmlns:ctrl="clr-namespace:OhMyGittForWin.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="#1E1F22">

    <UserControl.Resources>
        <conv:DiffTypeToColorConverter x:Key="DiffColorConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Word Highlight Background Converter -->
        <Style x:Key="WordPieceStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#38547C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="False">
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top IDEA Header Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Dual Path Sub-Header -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Main Hunk-based Diff Viewer with Bezier Ribbons -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top IDEA Header Toolbar -->
        <Border Grid.Row="0" Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="True">
                <!-- Right Summary: e.g. "3 differences, 0 included" -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1E2024" CornerRadius="4" Padding="8,3" BorderBrush="#3E4249" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalDifferences, StringFormat='{}{0} differences'}" Foreground="#9DA5B4" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text=", " Foreground="#9DA5B4" FontSize="11"/>
                            <TextBlock Text="{Binding IncludedCount, StringFormat='{}{0} included'}" Foreground="#E5C07B" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Left Action Pills & Toggles -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Title pill -->
                    <TextBlock Text="Commit: " Foreground="#828997" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FilePath}" Foreground="#D7DAE0" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <!-- Side-by-side dropdown pill -->
                    <Border Background="#1E2024" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Side-by-side viewer" Foreground="#ABB2BF" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text=" ▾" Foreground="#61AFEF" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Do not ignore whitespaces pill -->
                    <Border Background="#1E2024" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Do not ignore" Foreground="#ABB2BF" FontSize="11"/>
                            <TextBlock Text=" ▾" Foreground="#61AFEF" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Highlight words pill -->
                    <Border Background="#1E2024" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Highlight words" Foreground="#ABB2BF" FontSize="11"/>
                            <TextBlock Text=" ▾" Foreground="#61AFEF" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Dual Sub-Header (Left commit sha, Right current version checkbox) -->
        <Border Grid.Row="1" Background="#21252B" BorderBrush="#2F333D" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left file header -->
                    <ColumnDefinition Width="*"/>
                    <!-- Middle spacer -->
                    <ColumnDefinition Width="130"/>
                    <!-- Right file header -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✔ " Foreground="#98C379" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LeftCommitSha}" Foreground="#61AFEF" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding FilePath}" Foreground="#ABB2BF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Right Title with Checkbox -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RightTitle}" Foreground="#E5C07B" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Hunk-based Diff Viewer with Bezier Ribbons -->
        <ScrollViewer Grid.Row="2" Background="#1E1F22"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      CanContentScroll="True">
            <ItemsControl ItemsSource="{Binding Hunks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- A Single Diff Hunk Block with Left lines, Middle Ribbon Gutter, Right lines -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <!-- Column 0: Left Code Lines -->
                                <ColumnDefinition Width="*" MinWidth="300"/>
                                <!-- Column 1: Middle Connecting Gutter (Line Numbers + Ribbons + Actions) -->
                                <ColumnDefinition Width="130" MinWidth="130" MaxWidth="130"/>
                                <!-- Column 2: Right Code Lines -->
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Left Code Lines -->
                            <Border Grid.Column="0" 
                                    Background="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=Background}"
                                    BorderBrush="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=GutterBorder}"
                                    BorderThickness="0,0,1,0">
                                <ItemsControl ItemsSource="{Binding LeftLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="22" Padding="8,1,4,1">
                                                <ItemsControl ItemsSource="{Binding WordPieces}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text}" Style="{StaticResource WordPieceStyle}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Column 1: Middle Gutter (IDEA Linking Ribbons + Chevrons + Checkboxes) -->
                            <Grid Grid.Column="1" Background="#26282E">
                                <!-- The Smooth Bezier Connecting Ribbon (Fills the gap between left height & right height) -->
                                <ctrl:HunkRibbonConnector 
                                    HunkType="{Binding Type}"
                                    LeftLineCount="{Binding LeftLineCount}"
                                    RightLineCount="{Binding RightLineCount}"
                                    LineHeight="22"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <!-- Inner Gutter Overlay: Left line numbers, chevron, right line numbers, checkbox -->
                                <DockPanel LastChildFill="True" Margin="4,0">
                                    <!-- Left Line Number & Action Chevron -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Top" Height="22">
                                        <!-- >> Revert/Apply Action Button in Gutter -->
                                        <Button Content="»" Width="16" Height="18" Padding="0" Margin="0,0,4,0"
                                                Background="Transparent" BorderThickness="0" Foreground="#61AFEF" FontWeight="Bold" FontSize="11"
                                                Cursor="Hand" ToolTip="Revert / Apply change"
                                                Visibility="{Binding HasDifferences, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Left Line Number(s) -->
                                        <TextBlock Text="{Binding LeftLineRangeDisplay}" Foreground="#7F848E" FontSize="11" 
                                                   FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                                    </StackPanel>

                                    <!-- Right Line Number & Checkbox -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top" Height="22">
                                        <!-- Right Line Number(s) -->
                                        <TextBlock Text="{Binding RightLineRangeDisplay}" Foreground="#7F848E" FontSize="11" 
                                                   FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" Width="36" TextAlignment="Left" Margin="4,0,4,0"/>

                                        <!-- [ ] Checkbox to selectively include/stage hunk -->
                                        <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center"
                                                  Visibility="{Binding HasDifferences, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <!-- Column 2: Right Code Lines -->
                            <Border Grid.Column="2" 
                                    Background="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=Background}"
                                    BorderBrush="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=GutterBorder}"
                                    BorderThickness="1,0,0,0">
                                <ItemsControl ItemsSource="{Binding RightLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="22" Padding="8,1,4,1">
                                                <ItemsControl ItemsSource="{Binding WordPieces}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text}" Style="{StaticResource WordPieceStyle}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
