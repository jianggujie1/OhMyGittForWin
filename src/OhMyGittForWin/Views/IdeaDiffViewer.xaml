<UserControl x:Class="OhMyGittForWin.Views.IdeaDiffViewer"
             x:Name="RootDiffViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:OhMyGittForWin.Converters"
             xmlns:ctrl="clr-namespace:OhMyGittForWin.Controls"
             xmlns:views="clr-namespace:OhMyGittForWin.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100"
             Background="#1E1F22">

    <UserControl.Resources>
        <conv:DiffTypeToColorConverter x:Key="DiffColorConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Word Highlight Background Converter -->
        <Style x:Key="WordPieceStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#38547C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="False">
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top IDEA Header Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Dual Path Sub-Header -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Main Hunk-based Diff Viewer with Bezier Ribbons -->
            <RowDefinition Height="*"/>
            <!-- 4. Synchronized Horizontal Scrollbars (Only shown when lines exceed viewport) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top IDEA Header Toolbar -->
        <Border Grid.Row="0" Background="#2B2D30" BorderBrush="#393B40" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="True">
                <!-- Right Summary: e.g. "3 differences (+14 ~22 -8), 0 included" -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1E2024" CornerRadius="4" Padding="8,3" BorderBrush="#3E4249" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalDifferences, StringFormat='{}{0} differences'}" Foreground="#9DA5B4" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text=" (" Foreground="#5C6370" FontSize="11"/>
                            <TextBlock Text="{Binding Additions, StringFormat='+{0}'}" Foreground="#98C379" FontWeight="Bold" FontSize="11" ToolTip="Added lines"/>
                            <TextBlock Text=" " Foreground="#5C6370" FontSize="11"/>
                            <TextBlock Text="{Binding Modifications, StringFormat='~{0}'}" Foreground="#61AFEF" FontWeight="Bold" FontSize="11" ToolTip="Modified lines"/>
                            <TextBlock Text=" " Foreground="#5C6370" FontSize="11"/>
                            <TextBlock Text="{Binding Deletions, StringFormat='-{0}'}" Foreground="#E06C75" FontWeight="Bold" FontSize="11" ToolTip="Deleted lines"/>
                            <TextBlock Text="), " Foreground="#5C6370" FontSize="11"/>
                            <TextBlock Text="{Binding IncludedCount, StringFormat='{}{0} included'}" Foreground="#E5C07B" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Left Action Pills & Toggles -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Title pill -->
                    <TextBlock Text="Commit: " Foreground="#828997" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FilePath}" Foreground="#D7DAE0" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <!-- Side-by-side dropdown pill -->
                    <Border Background="#1E2024" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Side-by-side viewer" Foreground="#ABB2BF" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text=" ▾" Foreground="#61AFEF" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Do not ignore whitespaces pill -->
                    <Border Background="#1E2024" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Do not ignore" Foreground="#ABB2BF" FontSize="11"/>
                            <TextBlock Text=" ▾" Foreground="#61AFEF" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Highlight words pill -->
                    <Border Background="#1E2024" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Highlight words" Foreground="#ABB2BF" FontSize="11"/>
                            <TextBlock Text=" ▾" Foreground="#61AFEF" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Dual Sub-Header (Left commit sha, Right current version checkbox) -->
        <Border Grid.Row="1" Background="#21252B" BorderBrush="#2F333D" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left file header: 50% width -->
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <!-- Middle spacer matching gutter width -->
                    <ColumnDefinition Width="124"/>
                    <!-- Right file header: 50% width -->
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✔ " Foreground="#98C379" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LeftCommitSha}" Foreground="#61AFEF" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding FilePath}" Foreground="#ABB2BF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Right Title with Checkbox -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RightTitle}" Foreground="#E5C07B" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Hunk-based Diff Viewer -->
        <ListBox x:Name="HunkListBox" Grid.Row="2" Background="#1E1F22"
                 BorderThickness="0"
                 ItemsSource="{Binding Hunks}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <ListBox.Resources>
                <!-- 1. Folded Hunk Template (Instant 0ms, exactly 2 visual elements) -->
                <DataTemplate x:Key="FoldedHunkTemplate">
                    <Border Height="28" Background="#16181D" BorderBrush="#252A36" BorderThickness="0,1,0,1" Margin="0,1"
                            Cursor="Hand" ToolTip="点击展开此段未变更代码" MouseLeftButtonUp="FoldBanner_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E232E"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="↕ " Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FoldedBannerText}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!-- 2. Normal Diff Hunk Template -->
                <DataTemplate x:Key="NormalHunkTemplate">
                    <Grid Margin="0,0,0,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Left Code Viewport (Fixed 50%) -->
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <!-- Column 1: Middle Connecting Gutter (Fixed 124px, Never Shifts Horizontally) -->
                            <ColumnDefinition Width="124" MinWidth="124" MaxWidth="124"/>
                            <!-- Column 2: Right Code Viewport (Fixed 50%) -->
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Left Code Lines (Only colored when lines exist) -->
                        <Border Grid.Column="0" Background="#1E1F22" BorderBrush="#2F333D" BorderThickness="0,0,1,0" ClipToBounds="True">
                            <Grid>
                                <!-- When Left has lines: render lines with type background -->
                                <ItemsControl ItemsSource="{Binding LeftLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="22" 
                                                    Background="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=Background}"
                                                    BorderBrush="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=GutterBorder}"
                                                    BorderThickness="0,0,0,0"
                                                    Padding="8,1,4,1"
                                                    ClipToBounds="True">
                                                <Canvas Height="20" ClipToBounds="False">
                                                    <Grid Height="20">
                                                        <Grid.RenderTransform>
                                                            <TranslateTransform X="{Binding Path=NegativeHorizontalOffset, ElementName=RootDiffViewer}"/>
                                                        </Grid.RenderTransform>

                                                        <!-- Fast Path: Direct single TextBlock for Unchanged lines (90%+ of lines) -->
                                                        <TextBlock x:Name="SimpleLeftText" Text="{Binding Text}" 
                                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="12"
                                                                   Foreground="#D4D4D4" VerticalAlignment="Center"/>

                                                        <!-- Intra-line word piece highlighting (Only instantiated when highlighted) -->
                                                        <ItemsControl x:Name="LeftPiecesHost" ItemsSource="{Binding WordPieces}" VerticalAlignment="Center"
                                                                      Visibility="Collapsed">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource WordPieceStyle}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Canvas>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasHighlights}" Value="True">
                                                    <Setter TargetName="SimpleLeftText" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="LeftPiecesHost" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- When Left has 0 lines (pure insertion): show subtle top insertion anchor notch -->
                                <Border Height="2" Background="#4E9F5D" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LeftLineCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Column 1: Middle Gutter (Left Line Numbers | Connecting Ribbon | Right Line Numbers) -->
                        <Grid Grid.Column="1" Background="#26282E" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Line Numbers (Line by line) -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftLines}" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="22" Padding="0,0,4,0">
                                            <TextBlock Text="{Binding LineNumber}" Foreground="#7F848E" FontSize="11" 
                                                       FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Middle Track: Ribbon and Floating Actions -->
                            <Grid Grid.Column="1" ClipToBounds="True">
                                <!-- The Bezier Connecting Ribbon -->
                                <ctrl:HunkRibbonConnector 
                                    HunkType="{Binding Type}"
                                    LeftLineCount="{Binding LeftLineCount}"
                                    RightLineCount="{Binding RightLineCount}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <!-- Action Chevron » and Checkbox [ ] aligned on the first line (Height=22) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Height="22"
                                            Visibility="{Binding HasDifferences, Converter={StaticResource BoolToVis}}">
                                    <Button Content="»" Width="16" Height="18" Padding="0" Margin="0,0,3,0"
                                            Background="Transparent" BorderThickness="0" Foreground="#61AFEF" FontWeight="Bold" FontSize="13"
                                            Cursor="Hand" ToolTip="Revert / Apply change">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Right Line Numbers (Line by line) -->
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding RightLines}" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="22" Padding="4,0,0,0">
                                            <TextBlock Text="{Binding LineNumber}" Foreground="#7F848E" FontSize="11" 
                                                       FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Column 2: Right Code Lines (Only colored when lines exist) -->
                        <Border Grid.Column="2" Background="#1E1F22" BorderBrush="#2F333D" BorderThickness="1,0,0,0" ClipToBounds="True">
                            <Grid>
                                <!-- When Right has lines: render lines with type background -->
                                <ItemsControl ItemsSource="{Binding RightLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="22" 
                                                    Background="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=Background}"
                                                    BorderBrush="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=GutterBorder}"
                                                    BorderThickness="0,0,0,0"
                                                    Padding="8,1,4,1"
                                                    ClipToBounds="True">
                                                <Canvas Height="20" ClipToBounds="False">
                                                    <Grid Height="20">
                                                        <Grid.RenderTransform>
                                                            <TranslateTransform X="{Binding Path=NegativeHorizontalOffset, ElementName=RootDiffViewer}"/>
                                                        </Grid.RenderTransform>

                                                        <!-- Fast Path: Direct single TextBlock for Unchanged lines (90%+ of lines) -->
                                                        <TextBlock x:Name="SimpleRightText" Text="{Binding Text}" 
                                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="12"
                                                                   Foreground="#D4D4D4" VerticalAlignment="Center"/>

                                                        <!-- Intra-line word piece highlighting (Only instantiated when highlighted) -->
                                                        <ItemsControl x:Name="RightPiecesHost" ItemsSource="{Binding WordPieces}" VerticalAlignment="Center"
                                                                      Visibility="Collapsed">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource WordPieceStyle}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Canvas>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasHighlights}" Value="True">
                                                    <Setter TargetName="SimpleRightText" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="RightPiecesHost" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- When Right has 0 lines (pure deletion): show subtle top deletion anchor notch -->
                                <Border Height="2" Background="#9E555C" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RightLineCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.Resources>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource NormalHunkTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFolded}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource FoldedHunkTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 4. Synchronized Horizontal Scrollbars (Pinned at Bottom, Both Sides Move in Lockstep) -->
        <Border Grid.Row="3" Background="#1E2024" BorderBrush="#2F333D" BorderThickness="0,1,0,0" Height="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=MaxHorizontalScroll, ElementName=RootDiffViewer}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left horizontal scrollbar -->
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <!-- Middle spacer -->
                    <ColumnDefinition Width="124"/>
                    <!-- Right horizontal scrollbar -->
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Left scrollbar -->
                <ScrollBar Grid.Column="0" Orientation="Horizontal"
                           Minimum="0"
                           Maximum="{Binding Path=MaxHorizontalScroll, ElementName=RootDiffViewer}"
                           ViewportSize="{Binding Path=ViewportWidth, ElementName=RootDiffViewer}"
                           Value="{Binding Path=HorizontalScrollValue, ElementName=RootDiffViewer, Mode=TwoWay}"
                           Height="12" Margin="8,0" VerticalAlignment="Center"/>

                <!-- Middle spacer -->
                <Border Grid.Column="1" Background="#26282E"/>

                <!-- Right scrollbar (Two-way bound to the exact same HorizontalScrollValue) -->
                <ScrollBar Grid.Column="2" Orientation="Horizontal"
                           Minimum="0"
                           Maximum="{Binding Path=MaxHorizontalScroll, ElementName=RootDiffViewer}"
                           ViewportSize="{Binding Path=ViewportWidth, ElementName=RootDiffViewer}"
                           Value="{Binding Path=HorizontalScrollValue, ElementName=RootDiffViewer, Mode=TwoWay}"
                           Height="12" Margin="8,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
