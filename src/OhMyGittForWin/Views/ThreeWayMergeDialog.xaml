<Window x:Class="OhMyGittForWin.Views.ThreeWayMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OhMyGittForWin.ViewModels"
        mc:Ignorable="d"
        Title="3-Way Merge 冲突解决器 - Neomorphic Edition" 
        Height="760" Width="1180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{StaticResource NeoBgBrush}"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:ThreeWayMergeViewModel />
    </Window.DataContext>

    <Border BorderBrush="#374151" BorderThickness="1">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Style="{StaticResource NeoCard}" Padding="16,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="✨ 自动消解简单冲突" 
                            Command="{Binding AutoResolveAllCommand}"
                            Style="{StaticResource NeoButton}" Margin="0,0,10,0"/>
                    <Button Content="💾 保存并解决 (APPLY)" 
                            Command="{Binding SaveAndCloseCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource NeoPrimaryButton}" Margin="0,0,10,0"/>
                    <Button Content="✕" Click="CloseButton_Click" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource NeoButton}" Width="32" Height="32" Padding="0" 
                            Foreground="{StaticResource NeoTextMuted}" ToolTip="关闭"/>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="3-WAY CONFLICT RESOLVER" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="{Binding FileName, StringFormat='正在解决冲突文件: {0}'}" 
                               Foreground="{StaticResource NeoTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Action Bar: Fast accept actions and status pill -->
        <Border Grid.Row="1" Style="{StaticResource NeoSunkenCard}" Padding="12,8" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="&gt;&gt; 采纳左侧 (Local)" 
                            Command="{Binding AcceptLocalCommand}"
                            Style="{StaticResource NeoAccentBlueButton}" Margin="0,0,8,0"/>
                    <Button Content="&lt;&lt; 采纳右侧 (Remote)" 
                            Command="{Binding AcceptRemoteCommand}"
                            Style="{StaticResource NeoButton}" Margin="0,0,8,0"/>
                    <Button Content="⚡ 合并双侧" 
                            Command="{Binding AcceptBothCommand}"
                            Style="{StaticResource NeoButton}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3 Columns (Left: Local, Middle: Result, Right: Remote) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Local / Ours (Cyan/Blue Theme) -->
            <Border Grid.Column="0" Style="{StaticResource NeoCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="采纳 &gt;&gt;" 
                                Command="{Binding AcceptLocalCommand}"
                                Style="{StaticResource NeoAccentBlueButton}" Padding="8,3" FontSize="11"/>
                        <TextBlock Text="本地修改 (LOCAL / HEAD)" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding SelectedChunk.LocalText, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Cascadia Code, Consolas" FontSize="12"
                             Style="{StaticResource NeoTextBox}" Padding="10"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Column 2: Result (Green Glow / Interactive) -->
            <Border Grid.Column="2" Style="{StaticResource NeoCard}" Padding="10" BorderBrush="#10B981" BorderThickness="1.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="4">
                        <TextBlock Text="⭐ 最终合并结果 (RESULT / 实时可编辑)" Foreground="#10B981" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBox Grid.Row="1" Text="{Binding SelectedChunk.ResultText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Cascadia Code, Consolas" FontSize="12"
                             Foreground="#34D399"
                             Style="{StaticResource NeoTextBox}" Padding="10"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Column 3: Remote / Incoming (Orange/Amber Theme) -->
            <Border Grid.Column="4" Style="{StaticResource NeoCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="&lt;&lt; 采纳" 
                                Command="{Binding AcceptRemoteCommand}"
                                Style="{StaticResource NeoButton}" Padding="8,3" FontSize="11"/>
                        <TextBlock Text="传入修改 (REMOTE / THEIRS)" Foreground="#FB923C" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding SelectedChunk.RemoteText, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Cascadia Code, Consolas" FontSize="12"
                             Style="{StaticResource NeoTextBox}" Padding="10"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Chunk Selector -->
        <Border Grid.Row="3" Style="{StaticResource NeoSunkenCard}" Padding="12,8" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="冲突块切换: " Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ListBox ItemsSource="{Binding Chunks}" SelectedItem="{Binding SelectedChunk}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource NeoCard}" Padding="8,4" Margin="3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ChunkIndex, StringFormat='块 #{0} '}" Foreground="{StaticResource NeoTextPrimary}" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding StatusDescription}" Foreground="#F59E0B" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
