<Window x:Class="OhMyGittForWin.Views.ManageRemotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Git 远程仓库与分支管理 - OhMyGittForWin"
        Height="620" Width="740"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{StaticResource NeoBgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="4"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#374151" BorderThickness="1">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Existing Remotes -->
            <RowDefinition Height="*"/>
            <!-- 2. Add New Remote -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Status & Bottom Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Card -->
        <Border Grid.Row="0" Style="{StaticResource NeoCard}" Padding="16,12" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Button Content="✕" Click="BtnClose_Click" DockPanel.Dock="Right" 
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource NeoButton}" Width="30" Height="30" Padding="0" 
                        Foreground="{StaticResource NeoTextMuted}" VerticalAlignment="Center" ToolTip="关闭"/>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="REMOTE REPOSITORIES &amp; BRANCHES" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="远程仓库管理与分支推送" Foreground="{StaticResource NeoTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. Existing Remotes Card -->
        <Border Grid.Row="1" Style="{StaticResource NeoCard}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="已配置的远程源 (REMOTES)" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" Margin="2,0,0,8"/>

                <Border Grid.Row="1" Style="{StaticResource NeoSunkenCard}" Padding="6">
                    <ListBox x:Name="RemotesListBox" Background="Transparent" BorderThickness="0"
                             SelectionChanged="RemotesListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" CornerRadius="8" Padding="12,8" Margin="0,2" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#252A36"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#2B3241"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#4B5563"/>
                                                    <Setter TargetName="itemBorder" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🌐 " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#61AFEF" FontWeight="Bold" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Url}" Foreground="{StaticResource NeoTextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Remote Action Toolbar -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Branch specification for push -->
                    <Border Grid.Row="0" Style="{StaticResource NeoSunkenCard}" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="本地分支:" Foreground="{StaticResource NeoTextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtLocalBranch" Grid.Column="1" Style="{StaticResource NeoTextBox}" Height="32" Padding="8,5" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="2" Text="➜  目标远程分支:" Foreground="{StaticResource NeoTextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtTargetRemoteBranch" Grid.Column="3" Style="{StaticResource NeoTextBox}" Height="32" Padding="8,5"/>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <DockPanel Grid.Row="1" LastChildFill="False">
                        <Button x:Name="BtnDeleteRemote" Content="🗑 删除远程源" Click="BtnDeleteRemote_Click" DockPanel.Dock="Left"
                                Style="{StaticResource NeoButton}" Foreground="#EF4444" IsEnabled="False"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="BtnBindToken" Content="🔑 绑定 Token" Click="BtnBindToken_Click"
                                    Style="{StaticResource NeoButton}" Margin="0,0,8,0" IsEnabled="False"
                                    ToolTip="为当前选中的远程仓库配置 GitHub Personal Access Token"/>
                            <Button x:Name="BtnFetch" Content="⬇ 拉取分支 (Fetch)" Click="BtnFetch_Click"
                                    Style="{StaticResource NeoButton}" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="BtnPush" Content="🚀 推送并创建远程分支 (Push -u)" Click="BtnPush_Click"
                                    Style="{StaticResource NeoPrimaryButton}" IsEnabled="False"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Add Remote Card -->
        <Border Grid.Row="2" Style="{StaticResource NeoCard}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="添加新远程仓库 (ADD NEW REMOTE)" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" Margin="2,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Remote Name -->
                    <TextBox x:Name="TxtRemoteName" Grid.Column="0" Text="origin"
                             Style="{StaticResource NeoTextBox}" Height="38" Padding="10,8" ToolTip="远程源别名，如 origin 或 upstream"/>

                    <!-- Remote URL -->
                    <TextBox x:Name="TxtRemoteUrl" Grid.Column="2" 
                             Style="{StaticResource NeoTextBox}" Height="38" Padding="10,8" 
                             ToolTip="远程仓库完整地址 (https://github.com/... 或 git@github.com:...)"/>

                    <!-- Add Button -->
                    <Button Grid.Column="4" Content="＋ 添加远程" Click="BtnAddRemote_Click"
                            Style="{StaticResource NeoAccentBlueButton}" Height="38" Padding="14,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Status Feedback & Close -->
        <Border Grid.Row="3" Style="{StaticResource NeoSunkenCard}" Padding="12,8">
            <DockPanel LastChildFill="True">
                <Button Content="关闭" DockPanel.Dock="Right" Click="BtnClose_Click"
                        Style="{StaticResource NeoButton}" Padding="16,6"/>
                <TextBlock x:Name="TxtStatus" Text="选择远程仓库后可进行 Fetch 或 Push 操作" 
                           Foreground="{StaticResource NeoTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
