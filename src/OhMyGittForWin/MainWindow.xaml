<Window x:Class="OhMyGittForWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:OhMyGittForWin.Converters"
        xmlns:vm="clr-namespace:OhMyGittForWin.ViewModels"
        xmlns:views="clr-namespace:OhMyGittForWin.Views"
        mc:Ignorable="d"
        Title="OhMyGit - Neomorphic Edition" 
        Icon="Assets/app.ico"
        Height="860" Width="1380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource NeoBgBrush}"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:DiffTypeToColorConverter x:Key="DiffColorConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid x:Name="RootContainer" Background="{StaticResource NeoBgBrush}">
        <Grid.RowDefinitions>
            <!-- 0. Unified Top Bar (Title + Actions) -->
            <RowDefinition Height="50"/>
            <!-- 1. Workspace Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. Unified Pro Header Bar (Zero Redundancy!) -->
        <Border Grid.Row="0" Background="#151820" BorderBrush="#232834" BorderThickness="0,0,0,1">
            <Grid>
                <DockPanel LastChildFill="True">
                    <!-- Right: Action Buttons + Window Controls -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="📂 打开仓库" Command="{Binding OpenRepositoryCommand}"
                                Style="{StaticResource NeoButton}" Height="32" Padding="10,0" Margin="0,0,6,0"/>

                        <!-- Interactive Refresh Button with Rotating Spinner -->
                        <Button Command="{Binding RefreshRepositoryCommand}"
                                Style="{StaticResource NeoButton}" Height="32" Padding="10,0" Margin="0,0,6,0" ToolTip="刷新仓库状态">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔄" RenderTransformOrigin="0.5,0.5" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="refreshSpin" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="SpinStory">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:0.75"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="SpinStory"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="刷新" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Pull Button (with Behind Count Badge) -->
                        <Button Command="{Binding PullCommand}"
                                Style="{StaticResource NeoButton}" Height="32" Padding="12,0" Margin="0,0,6,0"
                                ToolTip="从远程拉取并合并最新代码 (git pull)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⬇ 拉取 (Pull)" VerticalAlignment="Center"/>
                                <Border Background="#0284C7" CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasBehindCommits, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CurrentBehindCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Push Button (with Ahead Count Badge) -->
                        <Button Command="{Binding PushCommand}"
                                Style="{StaticResource NeoPrimaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0"
                                ToolTip="推送当前分支提交到远程仓库 (git push)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⬆ 推送 (Push)" VerticalAlignment="Center"/>
                                <Border Background="#EA580C" CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasAheadCommits, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CurrentAheadCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Content="🌐 远程管理" Command="{Binding ManageRemotesCommand}"
                                Style="{StaticResource NeoButton}" Height="32" Padding="10,0" Margin="0,0,8,0"/>
                        <Button Content="⚡ 3-Way 冲突解决器" Click="OpenConflictResolver_Click"
                                Style="{StaticResource NeoAccentBlueButton}" Height="32" Padding="12,0" Margin="0,0,8,0"/>
                        <Button Content="⚙️ 设置" Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource NeoButton}" Height="32" Padding="12,0" Margin="0,0,12,0"
                                ToolTip="偏好设置 (GPU 硬件加速与渲染模式、AI 提交服务等)"/>

                        <!-- Subtle Separator -->
                        <Rectangle Width="1" Height="22" Fill="#282E3B" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Window Control Buttons with Smooth Fade -->
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="44" Height="50" 
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeoTextMuted}"
                                FontSize="13" Content="─" ToolTip="最小化">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#252A36"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="44" Height="50" 
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeoTextMuted}"
                                FontSize="12" Content="□" ToolTip="最大化 / 还原">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#252A36"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="48" Height="50" 
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeoTextMuted}"
                                FontSize="13" Content="✕" ToolTip="关闭">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#E11D48"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Left: App Brand & Status Pills -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <!-- Brand Icon with Warm Orange Glow -->
                        <Border CornerRadius="8" Width="28" Height="28" 
                                Effect="{StaticResource NeoGlowOrange}" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="Assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        
                        <TextBlock Text="OhMyGit" Foreground="{StaticResource NeoTextPrimary}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <Rectangle Width="1" Height="16" Fill="#282E3B" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <!-- Repo Pill -->
                        <Border Style="{StaticResource NeoSunkenCard}" Padding="10,4" Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁 " FontSize="11"/>
                                <TextBlock Text="{Binding RepoName}" Foreground="{StaticResource NeoTextPrimary}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Branch Pill with Neon Green Indicator -->
                        <Border Style="{StaticResource NeoSunkenCard}" Padding="10,4"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{Binding SyncStatusToolTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding CurrentBranch}" Foreground="#10B981" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Indeterminate Neon Loading Progress Bar attached to Header Bottom -->
                <ProgressBar VerticalAlignment="Bottom" Height="2"
                             IsIndeterminate="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Foreground="{StaticResource NeoAccentOrangeBrush}"
                             Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- 1. Workspace Content -->
        <Grid Grid.Row="1" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- MAIN WORKSPACE -->
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Branches Card -->
            <Border Grid.Column="0" Style="{StaticResource NeoCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="BRANCHES" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Branches.Count, StringFormat='({0})'}" Foreground="{StaticResource NeoTextMuted}" FontSize="11" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="＋ 新建" ToolTip="新建本地分支" Command="{Binding CreateBranchCommand}"
                                    Style="{StaticResource NeoButton}" Padding="7,3" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="🌐 远程" ToolTip="管理远程源与分支推送" Command="{Binding ManageRemotesCommand}"
                                    Style="{StaticResource NeoButton}" Padding="7,3" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource NeoSunkenCard}" Padding="6">
                        <ListBox ItemsSource="{Binding Branches}" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 MouseDoubleClick="BranchesListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NeoListBoxItem}">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu Background="#20242D" Foreground="#E2E8F0" BorderBrush="#374151">
                                                <MenuItem Header="切换检出此分支 (Checkout)" 
                                                          Command="{Binding DataContext.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator Background="#374151"/>
                                                <MenuItem Header="从远程拉取此分支 (Pull)" 
                                                          Command="{Binding DataContext.PullCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <MenuItem Header="推送到远程 / 管理远程 (Push...)" 
                                                          Command="{Binding DataContext.ManageRemotesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Separator Background="#374151"/>
                                                <MenuItem Header="删除分支 (Delete)" Foreground="#EF4444"
                                                          Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Ellipse Width="6" Height="6" Fill="#FF7700" Margin="0,0,8,0" DockPanel.Dock="Left"
                                                 VerticalAlignment="Center" Visibility="{Binding IsCurrentHead, Converter={StaticResource BoolToVis}}">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FF7700" BlurRadius="6" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="☁ " DockPanel.Dock="Left" Foreground="#60A5FA" FontSize="11"
                                                   Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center"/>

                                        <!-- Ahead & Behind Badges on Right -->
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <!-- Ahead Badge -->
                                            <Border Background="#3D1805" BorderBrush="#F97316" BorderThickness="0.8" CornerRadius="4"
                                                    Padding="4,1" Margin="0,0,3,0"
                                                    Visibility="{Binding HasAhead, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding AheadCount, StringFormat='领先远程 {0} 个提交 (待推送)'}">
                                                <TextBlock Text="{Binding AheadCount, StringFormat='↑{0}'}" Foreground="#FB923C" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <!-- Behind Badge -->
                                            <Border Background="#08253B" BorderBrush="#38BDF8" BorderThickness="0.8" CornerRadius="4"
                                                    Padding="4,1" Margin="0,0,3,0"
                                                    Visibility="{Binding HasBehind, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding BehindCount, StringFormat='落后远程 {0} 个提交 (待拉取)'}">
                                                <TextBlock Text="{Binding BehindCount, StringFormat='↓{0}'}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding FriendlyName}" Foreground="{StaticResource NeoTextPrimary}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Work Area Card with Segmented Switch -->
            <Border Grid.Column="2" Style="{StaticResource NeoCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Segmented Pill Switch (Neomorphic Slider Tab Header) -->
                    <Border Grid.Row="0" Style="{StaticResource NeoSunkenCard}" HorizontalAlignment="Left" Padding="4" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tab 0: Log -->
                            <RadioButton Content="📜 Git Log (提交历史树)" GroupName="MainTabs" IsChecked="True"
                                         Click="TabLog_Click" Cursor="Hand" Style="{StaticResource NeoSegmentedTabButton}"/>

                            <!-- Tab 1: Commit -->
                            <RadioButton Content="✍️ Commit (变更与暂存)" GroupName="MainTabs"
                                         Click="TabCommit_Click" Cursor="Hand" Style="{StaticResource NeoSegmentedTabButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab Content 0: Git Log -->
                    <Grid Grid.Row="1" x:Name="LogContentPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="260" MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box (Sunken Neomorphic capsule with placeholder) -->
                        <Border Grid.Row="0" Style="{StaticResource NeoSunkenCard}" Height="38" Padding="12,0" Margin="0,0,0,12">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Foreground="#6B7280" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="TxtFilter" Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeoTextPrimary}"
                                             CaretBrush="#FF7700" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="搜索提交历史 (支持按说明、作者、SHA 快速过滤)..." Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Commits Table (Sunken container with rounded rows) -->
                        <Border Grid.Row="1" Style="{StaticResource NeoSunkenCard}" Padding="6">
                            <DataGrid ItemsSource="{Binding FilteredCommits}" SelectedItem="{Binding SelectedCommit}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      Background="Transparent" Foreground="{StaticResource NeoTextPrimary}" 
                                      RowBackground="Transparent" AlternatingRowBackground="#1A1C23"
                                      GridLinesVisibility="None" BorderThickness="0"
                                      HeadersVisibility="Column"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource NeoTextMuted}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#2A2F3D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Padding="10,7" 
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridRow">
                                                    <Border x:Name="OuterBorder" 
                                                            CornerRadius="6" 
                                                            Margin="2,1"
                                                            BorderThickness="1"
                                                            BorderBrush="Transparent"
                                                            Background="Transparent"
                                                            SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <!-- Base Zebra Background Layer -->
                                                            <Border x:Name="BaseLayer"
                                                                    CornerRadius="5"
                                                                    Background="{TemplateBinding Background}"
                                                                    SnapsToDevicePixels="True"/>

                                                            <!-- Hover Illumination Layer -->
                                                            <Border x:Name="HoverLayer" 
                                                                    CornerRadius="5" 
                                                                    Background="#22283A" 
                                                                    BorderBrush="#333D54"
                                                                    BorderThickness="1"
                                                                    Opacity="0"
                                                                    SnapsToDevicePixels="True"/>

                                                            <!-- Selected Active Card Layer -->
                                                            <Border x:Name="SelectedLayer" 
                                                                    CornerRadius="5" 
                                                                    Background="#252F43" 
                                                                    BorderBrush="#3B82F6" 
                                                                    BorderThickness="1.2" 
                                                                    Opacity="0"
                                                                    SnapsToDevicePixels="True"/>

                                                            <!-- Left Neon Pill Indicator -->
                                                            <Border x:Name="ActivePill" 
                                                                    Width="3.5" 
                                                                    Height="18" 
                                                                    CornerRadius="1.75" 
                                                                    HorizontalAlignment="Left" 
                                                                    VerticalAlignment="Center" 
                                                                    Margin="3,0,0,0" 
                                                                    Background="#38BDF8" 
                                                                    Visibility="Collapsed"/>

                                                            <!-- Cells Presenter -->
                                                            <DataGridCellsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Instant Ambient Hover -->
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsSelected" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.9"/>
                                                        </MultiTrigger>

                                                        <!-- Instant Selection Active Pill -->
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SelectedLayer" Property="Opacity" Value="1.0"/>
                                                            <Setter TargetName="ActivePill" Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="HASH" Binding="{Binding ShortSha}" Width="90" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <DataGridTemplateColumn Header="REFS" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Unpushed Commit Badge -->
                                                    <Border CornerRadius="6" Padding="6,2" Margin="2,0"
                                                            Background="#431407" BorderBrush="#EA580C" BorderThickness="1"
                                                            ToolTip="此提交尚未推送到远程仓库 (Unpushed)"
                                                            Visibility="{Binding IsUnpushed, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⬆" Foreground="#FB923C" FontSize="10" FontWeight="Bold" Margin="0,0,3,0"/>
                                                            <TextBlock Text="待推送" Foreground="#FDBA74" FontSize="10" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <ItemsControl ItemsSource="{Binding BranchesAndTags}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6" Padding="7,2" Margin="2,0"
                                                                    Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="0.8"
                                                                    Cursor="Hand" SnapsToDevicePixels="True">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#2563EB"/>
                                                                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding}" Foreground="#93C5FD" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="COMMIT MESSAGE" Binding="{Binding MessageShort}" Width="*" FontWeight="Medium"/>
                                    <DataGridTextColumn Header="AUTHOR" Binding="{Binding AuthorName}" Width="120" Foreground="{StaticResource NeoTextSecondary}"/>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding FormattedDate}" Width="130" Foreground="{StaticResource NeoTextMuted}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Commit Detail Split -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="160"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Changed Files -->
                            <Border Grid.Column="0" Style="{StaticResource NeoSunkenCard}" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CHANGED FILES" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" Margin="4,2,0,8"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}"
                                             Background="Transparent" BorderThickness="0"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             ScrollViewer.CanContentScroll="True"
                                             ItemContainerStyle="{StaticResource NeoListBoxItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource NeoTextPrimary}" FontSize="12" Padding="4,2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Loading Overlay for Commit Files -->
                                    <Border Grid.Row="1" Background="#CC181A20" CornerRadius="6"
                                            Visibility="{Binding IsLoadingCommitFiles, Converter={StaticResource BoolToVis}}"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="⏳ 正在读取变更文件..." Foreground="{StaticResource NeoTextMuted}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                            <!-- IDEA-Style Dual-Pane Diff Viewer with Connecting Ribbons -->
                            <Grid Grid.Column="2">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentIdeaDiff}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <views:IdeaDiffViewer DataContext="{Binding CurrentIdeaDiff}"/>
                                </Grid>

                                <Border Padding="20">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource NeoSunkenCard}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentIdeaDiff}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="28" Background="#1E232E" BorderBrush="#2D3545" BorderThickness="1.2"
                                                HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="请在左侧列表中选择要查看的文件以显示 Diff" Foreground="{StaticResource NeoTextMuted}" 
                                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Loading Overlay for Diff -->
                                <Border Background="#D0181A20" CornerRadius="8"
                                        Visibility="{Binding IsLoadingDiff, Converter={StaticResource BoolToVis}}"
                                        IsHitTestVisible="False">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ 正在比对差异..." Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Tab Content 1: Commit Window -->
                    <Grid Grid.Row="1" x:Name="CommitContentPanel" Visibility="Hidden">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" MinWidth="260"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: File list & Commit Box -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Dual Panel: Staged and Unstaged Changes -->
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="100"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*" MinHeight="100"/>
                                </Grid.RowDefinitions>

                                <!-- Staged Files (已暂存的更改) -->
                                <Border Grid.Row="0" Style="{StaticResource NeoSunkenCard}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="全部取消暂存" Command="{Binding UnstageAllCommand}" 
                                                    IsEnabled="{Binding HasStagedFiles}"
                                                    Style="{StaticResource NeoButton}" Padding="8,3" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="已暂存的更改" Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                <Border Background="#132E22" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StagedFiles.Count}" Foreground="#10B981" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Empty Placeholder -->
                                        <Border Grid.Row="1" Visibility="{Binding IsStagedFilesEmpty, Converter={StaticResource BoolToVis}}" 
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="暂存区为空" Foreground="{StaticResource NeoTextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                                                <TextBlock Text="点击下方未暂存文件的 [+] 可加入暂存" Foreground="{StaticResource NeoTextSecondary}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Staged ListBox -->
                                        <ListBox Grid.Row="1" ItemsSource="{Binding StagedFiles}" SelectedItem="{Binding SelectedStagedFile}"
                                                 Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVis}}"
                                                 Background="Transparent" BorderThickness="0"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ItemContainerStyle="{StaticResource NeoListBoxItem}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,3" Margin="0,1" CornerRadius="6">
                                                        <DockPanel LastChildFill="True">
                                                            <Button DockPanel.Dock="Right" 
                                                                    Content="−" ToolTip="取消暂存此文件"
                                                                    Command="{Binding DataContext.UnstageFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource NeoButton}"
                                                                    Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                                                    FontSize="13" FontWeight="Bold" Foreground="#EF4444"/>
                                                            <Border Background="#1E232E" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColor}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource NeoTextPrimary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- Vertical Splitter between Staged and Unstaged -->
                                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS"/>

                                <!-- Unstaged Files (未暂存的更改) -->
                                <Border Grid.Row="2" Style="{StaticResource NeoSunkenCard}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="全部暂存 +" Command="{Binding StageAllCommand}" 
                                                    IsEnabled="{Binding HasUnstagedFiles}"
                                                    Style="{StaticResource NeoButton}" Padding="8,3" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="未暂存的更改" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                <Border Background="#33240D" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UnstagedFiles.Count}" Foreground="#F59E0B" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Empty Placeholder -->
                                        <Border Grid.Row="1" Visibility="{Binding IsUnstagedFilesEmpty, Converter={StaticResource BoolToVis}}" 
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="没有未暂存的更改" Foreground="{StaticResource NeoTextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Unstaged ListBox -->
                                        <ListBox Grid.Row="1" ItemsSource="{Binding UnstagedFiles}" SelectedItem="{Binding SelectedUnstagedFile}"
                                                 Visibility="{Binding HasUnstagedFiles, Converter={StaticResource BoolToVis}}"
                                                 Background="Transparent" BorderThickness="0"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ItemContainerStyle="{StaticResource NeoListBoxItem}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,3" Margin="0,1" CornerRadius="6">
                                                        <DockPanel LastChildFill="True">
                                                            <Button DockPanel.Dock="Right" 
                                                                    Content="+" ToolTip="暂存此文件"
                                                                    Command="{Binding DataContext.StageFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource NeoButton}"
                                                                    Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                                                    FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                                                            <Border Background="#1E232E" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColor}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource NeoTextPrimary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Commit Message Box & Glowing Orange Commit Button -->
                            <Border Grid.Row="2" Style="{StaticResource NeoCard}" Padding="14">
                                <StackPanel Orientation="Vertical">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StagedFiles.Count, StringFormat='已暂存: {0} 个文件'}" Foreground="#10B981" FontSize="11" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="COMMIT MESSAGE" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Command="{Binding GenerateAiCommitMessageCommand}"
                                                    IsEnabled="{Binding CanGenerateAiCommit}"
                                                    Style="{StaticResource NeoButton}"
                                                    Background="#261E38" BorderBrush="#8B5CF6" BorderThickness="1"
                                                    Foreground="#C4B5FD"
                                                    Padding="8,2" Margin="0,0,6,0"
                                                    ToolTip="智能识别待提交的代码变更，自动生成规范的 Commit Message">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✨" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding AiCommitStatusText}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OpenAiSettingsCommand}"
                                                    Content="⚙️" ToolTip="配置 AI 服务（API Key、模型、服务商）"
                                                    Style="{StaticResource NeoButton}"
                                                    Width="24" Height="22" Padding="0" FontSize="10"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource NeoTextBox}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button Content="🚀 确认提交 (COMMIT)" Command="{Binding CommitChangesCommand}"
                                             Style="{StaticResource NeoPrimaryButton}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Right: Live Dual-Pane Diff of Changed File -->
                        <Grid Grid.Column="2">
                            <!-- Clean Working Tree (StatusFiles.Count == 0) -->
                            <Border Padding="24" Style="{StaticResource NeoSunkenCard}"
                                    Visibility="{Binding IsWorkingTreeClean, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="#1E232E" BorderBrush="#2D3545" BorderThickness="1.2"
                                            HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock Text="✨" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="工作区干净 (Clean Working Tree)" Foreground="{StaticResource NeoTextPrimary}" 
                                               FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="当前仓库没有检测到任何未提交的代码更改" Foreground="{StaticResource NeoTextMuted}" 
                                               FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="若要查看历史版本的提交差异，请切换至上方的“Git Log”选项卡" Foreground="{StaticResource NeoTextSecondary}" 
                                               FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Has Changes to Commit (StatusFiles.Count > 0) -->
                            <Grid Visibility="{Binding HasChangesToCommit, Converter={StaticResource BoolToVis}}">
                                <!-- Active Diff View (visible when StatusIdeaDiff != null) -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIdeaDiff}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <!-- Show "Stage" when file is Unstaged -->
                                            <Button Content="+ 暂存此文件" Command="{Binding StageFileCommand}" CommandParameter="{Binding SelectedStatusFile}"
                                                    Padding="10,4" FontSize="11">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NeoButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedStatusFile.IsStaged}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- Show "Unstage" when file is Staged -->
                                            <Button Content="− 取消暂存" Command="{Binding UnstageFileCommand}" CommandParameter="{Binding SelectedStatusFile}"
                                                    Padding="10,4" FontSize="11">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NeoButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedStatusFile.IsStaged}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#1E232E" BorderBrush="{Binding SelectedStatusFile.StagedTagColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SelectedStatusFile.StagedLabel}" Foreground="{Binding SelectedStatusFile.StagedTagColor}" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedStatusFile.FilePath}" 
                                                       Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Embedded Dual-Pane IDEA Diff Viewer for Uncommitted Working Changes -->
                                    <views:IdeaDiffViewer Grid.Row="1" DataContext="{Binding StatusIdeaDiff}"/>
                                </Grid>

                                <!-- Placeholder when changed files exist, but none is selected -->
                                <Border Padding="20">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource NeoSunkenCard}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIdeaDiff}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="28" Background="#1E232E" BorderBrush="#2D3545" BorderThickness="1.2"
                                                HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="请在左侧列表中选择要查看的变更文件以显示 Diff" Foreground="{StaticResource NeoTextMuted}" 
                                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Loading Overlay for Diff -->
                                <Border Background="#D0181A20" CornerRadius="8"
                                        Visibility="{Binding IsLoadingDiff, Converter={StaticResource BoolToVis}}"
                                        IsHitTestVisible="False">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ 正在比对差异..." Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="1" Style="{StaticResource NeoSunkenCard}" Padding="14,6" Margin="0,12,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- GPU Acceleration Status & Toggle Button -->
                    <Button Command="{Binding ToggleGpuAccelerationCommand}"
                            ToolTip="{Binding GpuAccelerationToolTip}"
                            Background="Transparent" BorderThickness="0" Padding="4,2" Margin="0,0,12,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#252A36"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{Binding GpuAccelerationStatus}" Foreground="{Binding GpuAccelerationForeground}" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <TextBlock Text="LibGit2Sharp Native Engine" Foreground="{StaticResource NeoTextMuted}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="UTF-8" Foreground="{StaticResource NeoTextMuted}" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource NeoTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Grid>
</Window>
