<Window x:Class="OhMyGittForWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:OhMyGittForWin.Converters"
        xmlns:vm="clr-namespace:OhMyGittForWin.ViewModels"
        xmlns:views="clr-namespace:OhMyGittForWin.Views"
        mc:Ignorable="d"
        Title="OhMyGit - Neomorphic Edition" 
        Height="860" Width="1380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource NeoBgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:DiffTypeToColorConverter x:Key="DiffColorConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid x:Name="RootContainer" Background="{StaticResource NeoBgBrush}">
        <Grid.RowDefinitions>
            <!-- 0. Dark Neomorphic Title Bar -->
            <RowDefinition Height="38"/>
            <!-- 1. Workspace Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. Integrated Custom Dark Title Bar -->
        <Border Grid.Row="0" Background="#16181F" BorderBrush="#252A36" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Left: App Brand & Window Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Background="{StaticResource NeoOrangeGradient}" CornerRadius="6" Width="20" Height="20" Margin="0,0,8,0">
                        <TextBlock Text="Ω" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OhMyGit" Foreground="{StaticResource NeoTextPrimary}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="|" Foreground="#3E4452" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RepoName}" Foreground="{StaticResource NeoTextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="•" Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentBranch}" Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Window Caption (Centered, Non-interactive so dragging works anywhere) -->
                <TextBlock Text="OhMyGit - Neomorphic Git Engine" Foreground="#475569" FontSize="11" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

                <!-- Right: Custom Window Control Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize -->
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="44" Height="38" 
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeoTextMuted}"
                            FontSize="13" Content="─" ToolTip="最小化">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#252A36"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize / Restore -->
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="44" Height="38" 
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeoTextMuted}"
                            FontSize="12" Content="□" ToolTip="最大化 / 还原">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#252A36"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close -->
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Width="48" Height="38" 
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeoTextMuted}"
                            FontSize="13" Content="✕" ToolTip="关闭">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E11D48"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Workspace Content -->
        <Grid Grid.Row="1" Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- TOP BAR: Floating Neomorphic Header Island -->
        <Border Grid.Row="0" Style="{StaticResource NeoCard}" Padding="16,12" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons on Right -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="📂 打开仓库" Command="{Binding OpenRepositoryCommand}"
                            Style="{StaticResource NeoButton}" Margin="0,0,8,0"/>
                    <Button Content="🔄 刷新" Command="{Binding RefreshRepositoryCommand}"
                            Style="{StaticResource NeoButton}" Margin="0,0,8,0"/>
                    <Button Content="⬆ 推送 (Push)" Command="{Binding PushCommand}"
                            Style="{StaticResource NeoPrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="🌐 远程管理" Command="{Binding ManageRemotesCommand}"
                            Style="{StaticResource NeoButton}" Margin="0,0,10,0"/>
                    <Button Content="⚡ 3-Way 冲突解决器" Click="OpenConflictResolver_Click"
                            Style="{StaticResource NeoAccentBlueButton}"/>
                </StackPanel>

                <!-- Brand & Status Pill on Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand Icon with Warm Orange Glow -->
                    <Border Background="{StaticResource NeoOrangeGradient}" CornerRadius="12" Width="36" Height="36" 
                            Effect="{StaticResource NeoGlowOrange}" Margin="0,0,12,0">
                        <TextBlock Text="Ω" Foreground="White" FontWeight="Bold" FontSize="18" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Orientation="Vertical" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="OhMyGit" Foreground="{StaticResource NeoTextPrimary}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Neomorphic Git Engine" Foreground="{StaticResource NeoTextMuted}" FontSize="11"/>
                    </StackPanel>

                    <!-- Repo Pill -->
                    <Border Style="{StaticResource NeoSunkenCard}" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁 " FontSize="12"/>
                            <TextBlock Text="{Binding RepoName}" Foreground="{StaticResource NeoTextPrimary}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Branch Pill with Neon Green Indicator -->
                    <Border Style="{StaticResource NeoSunkenCard}" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,7,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding CurrentBranch}" Foreground="#10B981" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Branches Card -->
            <Border Grid.Column="0" Style="{StaticResource NeoCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="BRANCHES" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Branches.Count, StringFormat='({0})'}" Foreground="{StaticResource NeoTextMuted}" FontSize="11" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="＋ 新建" ToolTip="新建本地分支" Command="{Binding CreateBranchCommand}"
                                    Style="{StaticResource NeoButton}" Padding="7,3" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="🌐 远程" ToolTip="管理远程源与分支推送" Command="{Binding ManageRemotesCommand}"
                                    Style="{StaticResource NeoButton}" Padding="7,3" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource NeoSunkenCard}" Padding="6">
                        <ListBox ItemsSource="{Binding Branches}" Background="Transparent" BorderThickness="0"
                                 MouseDoubleClick="BranchesListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" CornerRadius="8" Padding="10,7" Margin="0,2" Background="Transparent">
                                                    <Border.ContextMenu>
                                                        <ContextMenu Background="#20242D" Foreground="#E2E8F0" BorderBrush="#374151">
                                                            <MenuItem Header="切换检出此分支 (Checkout)" 
                                                                      Command="{Binding DataContext.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                            <Separator Background="#374151"/>
                                                            <MenuItem Header="推送到远程 / 管理远程 (Push...)" 
                                                                      Command="{Binding DataContext.ManageRemotesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <Separator Background="#374151"/>
                                                            <MenuItem Header="删除分支 (Delete)" Foreground="#EF4444"
                                                                      Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#252A36"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#2B3241"/>
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="#4B5563"/>
                                                        <Setter TargetName="itemBorder" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Ellipse Width="6" Height="6" Fill="#FF7700" Margin="0,0,8,0" DockPanel.Dock="Left"
                                                 VerticalAlignment="Center" Visibility="{Binding IsCurrentHead, Converter={StaticResource BoolToVis}}">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#FF7700" BlurRadius="6" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="☁ " DockPanel.Dock="Left" Foreground="#60A5FA" FontSize="11"
                                                   Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FriendlyName}" Foreground="{StaticResource NeoTextPrimary}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Work Area Card with Segmented Switch -->
            <Border Grid.Column="2" Style="{StaticResource NeoCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Segmented Pill Switch (Neomorphic Slider Tab Header) -->
                    <Border Grid.Row="0" Style="{StaticResource NeoSunkenCard}" HorizontalAlignment="Left" Padding="4" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tab 0: Log -->
                            <RadioButton Content="📜 Git Log (提交历史树)" GroupName="MainTabs" IsChecked="True"
                                         Click="TabLog_Click" Cursor="Hand" Margin="2,0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="tabBorder" CornerRadius="10" Padding="16,8" Background="Transparent">
                                                        <ContentPresenter TextElement.FontWeight="Bold" TextElement.FontSize="12"
                                                                          TextElement.Foreground="{StaticResource NeoTextSecondary}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource NeoSurfaceGradient}"/>
                                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource NeoRaisedBorderBrush}"/>
                                                            <Setter TargetName="tabBorder" Property="BorderThickness" Value="1"/>
                                                            <Setter TargetName="tabBorder" Property="Effect" Value="{StaticResource NeoButtonShadow}"/>
                                                            <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <!-- Tab 1: Commit -->
                            <RadioButton Content="✍️ Commit (变更与暂存)" GroupName="MainTabs"
                                         Click="TabCommit_Click" Cursor="Hand" Margin="2,0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="tabBorder" CornerRadius="10" Padding="16,8" Background="Transparent">
                                                        <ContentPresenter TextElement.FontWeight="Bold" TextElement.FontSize="12"
                                                                          TextElement.Foreground="{StaticResource NeoTextSecondary}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource NeoSurfaceGradient}"/>
                                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource NeoRaisedBorderBrush}"/>
                                                            <Setter TargetName="tabBorder" Property="BorderThickness" Value="1"/>
                                                            <Setter TargetName="tabBorder" Property="Effect" Value="{StaticResource NeoButtonShadow}"/>
                                                            <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Tab Content 0: Git Log -->
                    <Grid Grid.Row="1" x:Name="LogContentPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="260" MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box (Sunken Neomorphic capsule) -->
                        <Border Grid.Row="0" Margin="0,0,0,12">
                            <TextBox Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NeoTextBox}" Height="40" Padding="12,10"
                                     ToolTip="搜索提交信息、作者或哈希"/>
                        </Border>

                        <!-- Commits Table (Sunken container with rounded rows) -->
                        <Border Grid.Row="1" Style="{StaticResource NeoSunkenCard}" Padding="6">
                            <DataGrid ItemsSource="{Binding FilteredCommits}" SelectedItem="{Binding SelectedCommit}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      Background="Transparent" Foreground="{StaticResource NeoTextPrimary}" 
                                      RowBackground="Transparent" AlternatingRowBackground="#1A1C23"
                                      GridLinesVisibility="None" BorderThickness="0"
                                      HeadersVisibility="Column">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource NeoTextMuted}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#2A2F3D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#252A36"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="HASH" Binding="{Binding ShortSha}" Width="90" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <DataGridTemplateColumn Header="REFS" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding BranchesAndTags}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1E293B" CornerRadius="6" Padding="6,2" Margin="2,0"
                                                                    BorderBrush="#3B82F6" BorderThickness="0.8">
                                                                <TextBlock Text="{Binding}" Foreground="#93C5FD" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="COMMIT MESSAGE" Binding="{Binding MessageShort}" Width="*" FontWeight="Medium"/>
                                    <DataGridTextColumn Header="AUTHOR" Binding="{Binding AuthorName}" Width="120" Foreground="{StaticResource NeoTextSecondary}"/>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding FormattedDate}" Width="130" Foreground="{StaticResource NeoTextMuted}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Commit Detail Split -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="160"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Changed Files -->
                            <Border Grid.Column="0" Style="{StaticResource NeoSunkenCard}" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CHANGED FILES" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" Margin="4,2,0,8"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource NeoTextPrimary}" FontSize="12" Padding="4,2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                            <!-- IDEA-Style Dual-Pane Diff Viewer with Connecting Ribbons -->
                            <views:IdeaDiffViewer Grid.Column="2" DataContext="{Binding CurrentIdeaDiff}"/>
                        </Grid>
                    </Grid>

                    <!-- Tab Content 1: Commit Window -->
                    <Grid Grid.Row="1" x:Name="CommitContentPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" MinWidth="260"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: File list & Commit Box -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Changed Files -->
                            <Border Grid.Row="0" Style="{StaticResource NeoSunkenCard}" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="暂存全部" Command="{Binding StageAllCommand}" Style="{StaticResource NeoButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="取消全部" Command="{Binding UnstageAllCommand}" Style="{StaticResource NeoButton}" Padding="8,4" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="CHANGES" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding StatusFiles}" SelectedItem="{Binding SelectedStatusFile}"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,3" Margin="0,1" CornerRadius="6">
                                                    <DockPanel LastChildFill="True">
                                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Border Background="#252A36" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource NeoTextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Commit Message Box & Glowing Orange Commit Button -->
                            <Border Grid.Row="2" Style="{StaticResource NeoCard}" Padding="14">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="COMMIT MESSAGE" Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource NeoTextBox}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button Content="🚀 确认提交 (COMMIT)" Command="{Binding CommitChangesCommand}"
                                            Style="{StaticResource NeoPrimaryButton}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Right: Live Dual-Pane Diff of Changed File -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="暂存此文件" Command="{Binding StageFileCommand}" CommandParameter="{Binding SelectedStatusFile}"
                                            Style="{StaticResource NeoButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="取消暂存" Command="{Binding UnstageFileCommand}" CommandParameter="{Binding SelectedStatusFile}"
                                            Style="{StaticResource NeoButton}" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedStatusFile.FilePath, StringFormat='CURRENT FILE: {0}'}" 
                                           Foreground="{StaticResource NeoTextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Embedded Dual-Pane IDEA Diff Viewer with Connecting Ribbons -->
                            <views:IdeaDiffViewer Grid.Row="1" DataContext="{Binding CurrentIdeaDiff}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Style="{StaticResource NeoSunkenCard}" Padding="14,6" Margin="0,12,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="LibGit2Sharp Native Engine" Foreground="{StaticResource NeoTextMuted}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="UTF-8" Foreground="{StaticResource NeoTextMuted}" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource NeoTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Grid>
</Window>
