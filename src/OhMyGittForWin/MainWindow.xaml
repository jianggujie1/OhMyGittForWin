<Window x:Class="OhMyGittForWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:OhMyGittForWin.Converters"
        xmlns:vm="clr-namespace:OhMyGittForWin.ViewModels"
        mc:Ignorable="d"
        Title="OhMyGit for Windows - 原生原生极速 Git 客户端" 
        Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#181818">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:DiffTypeToColorConverter x:Key="DiffColorConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation & Toolbar (IDEA Style) -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#2F2F2F" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons on Right -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="📂 打开仓库" Command="{Binding OpenRepositoryCommand}"
                            Background="#2D2D2D" Foreground="#E0E0E0" BorderBrush="#3F3F3F" Padding="10,5" Margin="4,0" FontWeight="SemiBold"/>
                    <Button Content="🔄 刷新" Command="{Binding RefreshRepositoryCommand}"
                            Background="#2D2D2D" Foreground="#E0E0E0" BorderBrush="#3F3F3F" Padding="10,5" Margin="4,0"/>
                    <Button Content="⚡ 3-Way 冲突解决器" Click="OpenConflictResolver_Click"
                            Background="#1A4971" Foreground="#9CDCFE" BorderBrush="#264F78" Padding="10,5" Margin="8,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Left App & Repo Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3574F0" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="Git" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <TextBlock Text="OhMyGit" Foreground="#E0E0E0" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Border Background="#2B2B2B" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前仓库: " Foreground="#888888" FontSize="12"/>
                            <TextBlock Text="{Binding RepoName}" Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#2B2B2B" CornerRadius="4" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌿 " FontSize="12"/>
                            <TextBlock Text="{Binding CurrentBranch}" Foreground="#CE9178" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Branches (IDEA Tool Window style) -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252526" Padding="10,6">
                        <TextBlock Text="分支列表 (Branches)" Foreground="#B0B0B0" FontWeight="SemiBold" FontSize="12"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Branches}" 
                             Background="Transparent" BorderThickness="0" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,1" CornerRadius="4">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="⭐" DockPanel.Dock="Left" Margin="0,0,6,0" 
                                                   Visibility="{Binding IsCurrentHead, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="☁ " DockPanel.Dock="Left" Foreground="#6A9955"
                                                   Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding FriendlyName}" Foreground="#D4D4D4" FontWeight="Normal"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#2B2B2B"/>

            <!-- Center Content Area: Tabs for [Log] and [Commit] -->
            <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="#252526" BorderBrush="#2B2B2B" BorderThickness="0,0,1,1" Padding="16,8">
                                        <ContentPresenter ContentSource="Header" TextElement.Foreground="#B0B0B0" TextElement.FontWeight="SemiBold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="0,2,0,0"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#3574F0"/>
                                            <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: Log (IDEA Git Log Viewer) -->
                <TabItem Header="📜 Git Log (提交树)">
                    <Grid Background="#1E1E1E">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="260" MinHeight="150"/>
                        </Grid.RowDefinitions>

                        <!-- Filter Bar -->
                        <Border Grid.Row="0" Background="#252526" Padding="8,6" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="🔍 搜索: " Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#1E1E1E" Foreground="White" BorderBrush="#3E3E42" Padding="6,3" FontSize="12"/>
                            </DockPanel>
                        </Border>

                        <!-- Commits DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredCommits}" SelectedItem="{Binding SelectedCommit}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  Background="#1E1E1E" Foreground="#D4D4D4" RowBackground="#1E1E1E" AlternatingRowBackground="#252526"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2B2B2B" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hash" Binding="{Binding ShortSha}" Width="80" FontWeight="SemiBold" Foreground="#3574F0"/>
                                <DataGridTemplateColumn Header="分支 / 标签" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding BranchesAndTags}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#264F78" CornerRadius="3" Padding="4,1" Margin="2,0">
                                                            <TextBlock Text="{Binding}" Foreground="#9CDCFE" FontSize="11"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="提交信息 (Commit Message)" Binding="{Binding MessageShort}" Width="*" FontWeight="Medium"/>
                                <DataGridTextColumn Header="作者" Binding="{Binding AuthorName}" Width="120" Foreground="#858585"/>
                                <DataGridTextColumn Header="日期" Binding="{Binding FormattedDate}" Width="140" Foreground="#858585"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#2B2B2B"/>

                        <!-- Commit Detail Split (Files on Left, Diff on Right) -->
                        <Grid Grid.Row="3" Background="#181818">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="150"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Commit changed files -->
                            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#252526" Padding="8,5">
                                        <TextBlock Text="变更文件列表" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}"
                                             Background="Transparent" BorderThickness="0" Padding="2">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#D4D4D4" Padding="4,2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#2B2B2B"/>

                            <!-- Diff Viewer -->
                            <Border Grid.Column="2" Background="#1E1E1E">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#252526" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Diff 预览: " Foreground="#888888" FontSize="11"/>
                                            <TextBlock Text="{Binding SelectedCommitFile}" Foreground="#ECECEC" FontWeight="SemiBold" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding CurrentDiff.Lines}"
                                             Background="#181818" BorderThickness="0"
                                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=Background}" Padding="4,1">
                                                    <TextBlock Text="{Binding Text}" 
                                                               Foreground="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=Foreground}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Commit (IDEA Commit Tool Window) -->
                <TabItem Header="✍️ Commit (变更与提交)">
                    <Grid Background="#1E1E1E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" MinWidth="240"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Changes list & Commit message -->
                        <Grid Grid.Column="0" Background="#1E1E1E">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#252526" Padding="10,6">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="暂存全部" Command="{Binding StageAllCommand}" Padding="6,2" FontSize="11" Margin="2,0" Background="#2D2D2D" Foreground="#D4D4D4"/>
                                        <Button Content="取消全部" Command="{Binding UnstageAllCommand}" Padding="6,2" FontSize="11" Margin="2,0" Background="#2D2D2D" Foreground="#D4D4D4"/>
                                    </StackPanel>
                                    <TextBlock Text="变更列表 (Changes)" Foreground="#B0B0B0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Changed files list with checkboxes -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding StatusFiles}" SelectedItem="{Binding SelectedStatusFile}"
                                     Background="Transparent" BorderThickness="0" Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,3" Margin="0,1" CornerRadius="3">
                                            <DockPanel LastChildFill="True">
                                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <Border Background="#2B2B2B" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="11" Foreground="#4EC9B0"/>
                                                </Border>
                                                <TextBlock Text="{Binding FilePath}" Foreground="#D4D4D4" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="2" Background="#252526" Padding="8,4" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0">
                                <TextBlock Text="提交信息 (Commit Message)" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Commit Message editor -->
                            <TextBox Grid.Row="3" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     Background="#181818" Foreground="#D4D4D4" BorderBrush="#2B2B2B" Padding="8" FontSize="12"/>

                            <!-- Commit Action Button -->
                            <Border Grid.Row="4" Background="#222222" Padding="8">
                                <Button Content="🚀 Commit 提交修改" Command="{Binding CommitChangesCommand}"
                                        Background="#107C41" Foreground="White" FontWeight="Bold" Padding="0,8" HorizontalAlignment="Stretch"/>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#2B2B2B"/>

                        <!-- Right: Live Diff for selected file -->
                        <Border Grid.Column="2" Background="#181818">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#252526" Padding="10,6">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="暂存该文件" Command="{Binding StageFileCommand}" CommandParameter="{Binding SelectedStatusFile}"
                                                    Background="#2D2D2D" Foreground="#9CDCFE" Padding="8,2" FontSize="11" Margin="2,0"/>
                                            <Button Content="取消暂存" Command="{Binding UnstageFileCommand}" CommandParameter="{Binding SelectedStatusFile}"
                                                    Background="#2D2D2D" Foreground="#CE9178" Padding="8,2" FontSize="11" Margin="2,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedStatusFile.FilePath, StringFormat='文件差异对比: {0}'}" 
                                                   Foreground="#ECECEC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <ListBox Grid.Row="1" ItemsSource="{Binding CurrentDiff.Lines}"
                                         Background="#181818" BorderThickness="0"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=Background}" Padding="6,1">
                                                <TextBlock Text="{Binding Text}" 
                                                           Foreground="{Binding Type, Converter={StaticResource DiffColorConv}, ConverterParameter=Foreground}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#1F1F1F" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="引擎: LibGit2Sharp (Native)" Foreground="#6A9955" FontSize="11" Margin="8,0"/>
                    <TextBlock Text="UTF-8" Foreground="#858585" FontSize="11" Margin="8,0"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
